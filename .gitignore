# ===== 编译产物 / 大二进制（不提交 GitHub）=====
# NtoNTier 客户端本体（内嵌 edge/hfs/tap 引擎，约 97MB）
dist/client/NtoNTier.exe
dist/client/src/NtoNTier.exe
# 引擎二进制（体积大，仓库只放源码，构建时需自行准备）
dist/client/edge.exe
dist/client/src/edge.exe
dist/client/hfs.exe
dist/client/src/hfs.exe
dist/client/tap-windows.exe
dist/client/src/tap-windows.exe
# 安装包（约 291MB）
dist/*-Setup.exe

